# Copia este archivo como .env.local y completa los valores.
# Supabase → Project Settings → API (o "Connect" en el dashboard).

# URL del proyecto: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Llave pública: "anon" (legacy) o "publishable" (sb_publishable_...).
# Es segura en el navegador porque RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio, usada en los enlaces de los emails (confirmación y
# restablecimiento). Opcional: si se omite, se usa el dominio del request.
# Local: http://localhost:3000 · Producción: https://tu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NUNCA agregues aquí la service_role / secret key: la app no la necesita.
